# Database - relative path for portability
DATABASE_URL="file:./db/custom.db"

# NextAuth - secret for JWT signing (generate new one for production: openssl rand -base64 32)
NEXTAUTH_SECRET="mundial2026-simulador-secret-key-change-in-production"

# NEXTAUTH_URL is auto-detected from request headers when behind reverse proxy
# Only set this for local development if auto-detection fails:
# NEXTAUTH_URL=http://localhost:3000
