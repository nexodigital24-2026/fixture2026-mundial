generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  password     String
  role         String        @default("user") // "admin" or "user"
  avatar       String?
  simulations  Simulation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Simulation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId    Int      // group match id or knockout match id
  matchType  String   @default("group") // "group" or "knockout"
  homeScore  Int      @default(-1)      // -1 = not set
  awayScore  Int      @default(-1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, matchId, matchType])
}

model Config {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}
